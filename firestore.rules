rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 클라우드 동기화: 본인 데이터만 읽기/쓰기
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 포트폴리오 공유: 로그인한 사용자만 만들고, 로그인한 사용자만 본다.
    //
    // 전에는 read/write가 모두 열려 있어 ① 코드를 추측하면 아무나 내용을
    // 읽을 수 있었고 ② 아무나 남의 공유 문서를 덮어쓰거나 지울 수 있었다.
    // update/delete는 로그인했더라도 막는다 — 공유는 한 번 만들면 끝이고,
    // 수정할 수 있어야 할 이유가 없다. 이 금지가 코드 충돌을 조용한
    // 덮어쓰기 대신 permission-denied로 드러내 주기도 한다.
    match /portfolio_shares/{code} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
